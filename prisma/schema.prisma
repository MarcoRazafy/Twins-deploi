// Mini Railway - internal database of the platform (PostgreSQL).
//
// Mirrors the domain model of src/lib/types.ts. Columns that only the server
// needs (password hashes, encrypted secrets, container runtime state, worker
// bookkeeping) never cross the API boundary: src/server/mappers.ts converts
// rows to the public types.
//
// Ids are generated by the application with a readable prefix (prj_, svc_,
// dep_ ...), see src/server/ids.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────── Access ──────────────────────────────────────

enum MemberRole {
  owner
  admin
  developer
  viewer
}

enum MemberStatus {
  active
  invited
}

model User {
  id           String       @id
  email        String       @unique
  name         String
  /// scrypt hash ("scrypt$N$r$p$salt$hash"). Null until an invited member sets a password.
  passwordHash String?
  role         MemberRole   @default(developer)
  status       MemberStatus @default(active)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  sessions  Session[]
  apiTokens ApiToken[]

  @@map("users")
}

model Session {
  id         String   @id
  /// SHA-256 of the cookie value: the raw token is never stored.
  tokenHash  String   @unique
  userId     String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model ApiToken {
  id         String    @id
  userId     String
  name       String
  /// First characters of the secret, safe to display.
  prefix     String
  /// SHA-256 of the secret.
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_tokens")
}

// ─────────────────────────────── Projects & services ─────────────────────────

model Project {
  id          String   @id
  name        String
  /// Lower-cased name: enforces case-insensitive uniqueness.
  nameKey     String   @unique
  slug        String   @unique
  description String   @default("")
  color       String   @default("purple")
  environment String   @default("production")
  region      String   @default("eu-west")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services    Service[]
  connections ServiceConnection[]
  deployments Deployment[]
  variables   EnvVariable[]
  domains     Domain[]
  databases   ManagedDatabase[]

  @@map("projects")
}

enum ServiceType {
  github
  docker
  postgres
}

enum ServiceStatus {
  online
  building
  deploying
  restarting
  crashed
  stopped
}

model Service {
  id        String        @id
  projectId String
  name      String
  /// kebab-case name: Docker network alias and part of the container name.
  slug      String
  type      ServiceType
  status    ServiceStatus @default(building)

  // Source - which columns are used depends on `type`.
  repo          String?
  branch        String?
  rootDirectory String  @default("/")
  autoDeploy    Boolean @default(true)
  image         String?
  tag           String?
  pgVersion     String?

  // Canvas position (top-left corner of the card).
  positionX Int @default(0)
  positionY Int @default(0)

  // Volume - no volume when volumeName is null.
  volumeName      String?
  volumeMountPath String?
  volumeSizeGb    Int?

  // Config
  port            Int    @default(3000)
  builder         String @default("nixpacks")
  buildCommand    String @default("")
  startCommand    String @default("")
  healthcheckPath String @default("")
  restartPolicy   String @default("on-failure")
  replicas        Int    @default(1)
  cpuLimit        Float  @default(1)
  memoryLimitMb   Int    @default(512)

  primaryDomain      String?
  activeDeploymentId String?
  latestDeploymentId String?

  // Runtime state, maintained by the worker.
  containerId   String?
  containerName String?
  /// Loopback port published by the running container (20000-29999).
  hostPort      Int?      @unique
  /// Last commit seen on the tracked branch (git sync).
  lastCommitSha String?
  restartCount  Int       @default(0)
  startedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deployments Deployment[]
  variables   EnvVariable[]
  domains     Domain[]
  database    ManagedDatabase?
  outgoing    ServiceConnection[] @relation("ConnectionFrom")
  incoming    ServiceConnection[] @relation("ConnectionTo")
  metrics     MetricSample[]

  @@unique([projectId, name])
  @@unique([projectId, slug])
  @@index([projectId])
  @@map("services")
}

/// Directed edge of the canvas: `from` consumes `to`.
model ServiceConnection {
  id            String   @id
  projectId     String
  fromServiceId String
  toServiceId   String
  createdAt     DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  from    Service @relation("ConnectionFrom", fields: [fromServiceId], references: [id], onDelete: Cascade)
  to      Service @relation("ConnectionTo", fields: [toServiceId], references: [id], onDelete: Cascade)

  @@unique([fromServiceId, toServiceId])
  @@index([projectId])
  @@map("service_connections")
}

// ─────────────────────────────── Deployments ─────────────────────────────────

enum DeploymentStatus {
  queued
  building
  deploying
  active
  failed
  crashed
  cancelled
  removed
}

/// A deployment row is also the job the worker picks up (status = queued).
model Deployment {
  id        String           @id
  projectId String
  serviceId String
  status    DeploymentStatus @default(queued)
  trigger   String

  commitSha     String?
  commitMessage String?
  commitAuthor  String?
  commitBranch  String?
  /// Image reference built or pulled for this deployment.
  image         String?
  creator       String

  progress   Int       @default(0)
  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  durationMs Int?
  error      String?

  // Worker bookkeeping
  lockedBy        String?
  heartbeatAt     DateTime?
  cancelRequested Boolean   @default(false)
  /// Next log sequence number (logs are append-only, ordered by seq).
  logSeq          Int       @default(0)

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  logs    DeploymentLog[]

  @@index([serviceId, createdAt])
  @@index([projectId, createdAt])
  @@index([status, createdAt])
  @@map("deployments")
}

model DeploymentLog {
  id           BigInt   @id @default(autoincrement())
  deploymentId String
  seq          Int
  ts           DateTime @default(now())
  /// debug | info | warn | error | success
  level        String
  /// build | deploy
  stream       String
  message      String

  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@unique([deploymentId, seq])
  @@map("deployment_logs")
}

// ─────────────────────────────── Configuration ───────────────────────────────

model EnvVariable {
  id        String   @id
  projectId String
  /// Null = shared variable of the project. PostgreSQL treats NULLs as distinct
  /// in unique constraints, so uniqueness of shared keys is enforced by the
  /// partial index added in the first migration (and checked in the service layer).
  serviceId String?
  key       String
  /// AES-256-GCM payload (see src/server/crypto.ts). Every value is encrypted,
  /// secret or not.
  valueEncrypted String
  isSecret  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([projectId, serviceId, key])
  @@index([serviceId])
  @@map("env_variables")
}

model Domain {
  id         String    @id
  projectId  String
  serviceId  String
  hostname   String    @unique
  /// generated | custom
  kind       String
  /// pending_dns | verifying | issuing_certificate | active | error
  status     String
  targetPort Int
  /// DnsRecord[] the user must create (empty for local and generated domains).
  dnsRecords Json      @default("[]")
  /// none | pending | issued | error
  sslStatus    String    @default("none")
  sslIssuer    String?
  sslExpiresAt DateTime?
  forceHttps Boolean   @default(false)
  createdAt  DateTime  @default(now())
  verifiedAt DateTime?
  lastCheckedAt DateTime?
  error      String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@index([projectId])
  @@map("domains")
}

// ─────────────────────────────── Managed PostgreSQL ──────────────────────────

/// A project database: one PostgreSQL container, backed 1:1 by a Service.
model ManagedDatabase {
  id        String @id
  serviceId String @unique
  projectId String
  name      String
  engine    String @default("postgres")
  version   String
  /// Hostname on the project's Docker network, e.g. "postgres.railway.internal".
  host      String
  port      Int    @default(5432)
  databaseName String
  username  String
  /// AES-256-GCM payload.
  passwordEncrypted String
  publicNetworking  Boolean @default(false)
  storageLimitMb    Int     @default(5120)
  maxConnections    Int     @default(100)
  extensions        String[] @default([])
  createdAt DateTime @default(now())

  project Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  backups DatabaseBackup[]

  @@index([projectId])
  @@map("managed_databases")
}

model DatabaseBackup {
  id          String    @id
  databaseId  String
  label       String
  /// automatic | manual
  type        String
  /// in_progress | completed | failed
  status      String
  sizeMb      Float     @default(0)
  /// Dump file under <data dir>/backups/databases/<databaseId>/.
  filePath    String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  database ManagedDatabase @relation(fields: [databaseId], references: [id], onDelete: Cascade)

  @@index([databaseId, createdAt])
  @@map("database_backups")
}

// ─────────────────────────────── Observability ───────────────────────────────

/// One row per managed container every sampling tick (kept 7 days).
model MetricSample {
  id         BigInt   @id @default(autoincrement())
  serviceId  String
  ts         DateTime @default(now())
  /// Percent of one CPU, as reported by `docker stats` (can exceed 100).
  cpuPercent Float
  memoryMb   Float
  /// Cumulative counters since the container started, in KB.
  netRxKb    Float
  netTxKb    Float

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, ts])
  @@map("metric_samples")
}

model ActivityEvent {
  id           String   @id
  type         String
  /// info | success | warning | error
  severity     String
  title        String
  description  String   @default("")
  projectId    String?
  serviceId    String?
  deploymentId String?
  actor        String
  read         Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([projectId, createdAt])
  @@map("activity_events")
}

// ─────────────────────────────── Platform ────────────────────────────────────

/// Key/value store for singleton documents: "platform" holds PlatformSettings.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

/// The single GitHub connection of the platform (id is always "default").
model GithubConnection {
  id            String   @id @default("default")
  login         String
  name          String
  accountType   String
  /// AES-256-GCM payload of the fine-grained personal access token.
  tokenEncrypted String
  scopes        String[] @default([])
  /// GithubAccount[]
  organizations Json     @default("[]")
  /// AES-256-GCM payload of the secret used to verify webhook signatures.
  webhookSecretEncrypted String
  connectedAt   DateTime @default(now())

  @@map("github_connections")
}

/// Background jobs other than deployments (domain checks, backups, restores…).
model Job {
  id         String    @id
  type       String
  payload    Json      @default("{}")
  /// pending | running | done | failed
  status     String    @default("pending")
  runAt      DateTime  @default(now())
  attempts   Int       @default(0)
  lockedBy   String?
  lockedAt   DateTime?
  error      String?
  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([status, runAt])
  @@map("jobs")
}
