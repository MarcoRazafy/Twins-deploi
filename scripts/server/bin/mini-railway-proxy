#!/usr/bin/python3 -I
"""Manage Mini Railway's NGINX reverse-proxy entries.

The platform runs unprivileged. It calls this helper through sudo (see
/etc/sudoers.d/mini-railway) to publish a hostname. The helper is the
privilege boundary, so it never accepts NGINX directives: it receives DATA
ONLY (a hostname and a loopback port), validates it strictly and renders the
configuration itself from a fixed template. NGINX is reloaded only after
`nginx -t` succeeds; otherwise the previous state is restored.

Usage:
  mini-railway-proxy apply --host app.example.test --port 20001
                           [--max-body-mb 50] [--read-timeout 60] [--gzip]
                           [--platform]
  mini-railway-proxy remove --host app.example.test [--platform]
  mini-railway-proxy list

Rules enforced here (defence in depth against bugs in the web layer):
  * the upstream is always 127.0.0.1:<port>: application containers publish
    their port on the loopback interface only, NGINX is the single entry point;
  * application ports must be inside the range reserved for containers
    (20000-29999), so a hostname can never expose PostgreSQL, a dev server or
    any other loopback-only service of this machine;
  * the hostnames listed in /etc/mini-railway/reserved-hosts (the platform's
    own domain, the machine name) can only be changed with --platform, which
    the platform uses for its own virtual host and never for a tenant domain.

Exit codes: 0 ok, 2 invalid input, 3 nginx rejected the configuration (rolled
back), 4 nginx could not be reloaded.
"""

import argparse
import fcntl
import json
import os
import re
import signal
import subprocess
import sys
import tempfile

NGINX = "/usr/sbin/nginx"
SYSTEMCTL = "/usr/bin/systemctl"
SAFE_ENV = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LC_ALL": "C"}
MAX_ENTRIES = 2000
MAX_HOSTNAME_LENGTH = 240  # "<host>.conf" must stay below NAME_MAX (255)
APP_PORTS = (20000, 29999)
PLATFORM_PORTS = (1024, 65535)

_LABEL = r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?"
HOSTNAME_RE = re.compile(rf"^(?:{_LABEL}\.)+[a-z](?:[a-z0-9-]{{0,61}}[a-z0-9])?$")
HEADER_RE = re.compile(r"^# mini-railway: host=(\S+) port=([0-9]+)(?: tls=([01]))?$")
ACME_WEBROOT = "var/lib/mini-railway/acme"

# Every vhost answers the ACME HTTP-01 challenge on port 80, so a certificate
# can be issued or renewed for it at any time (mini-railway-cert).
ACME_LOCATION = """\
    location ^~ /.well-known/acme-challenge/ {{
        root {webroot};
        default_type text/plain;
    }}
"""

PROXY_LOCATION = """\
    location / {{
        proxy_pass http://127.0.0.1:{port};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $mini_railway_connection_upgrade;
        proxy_read_timeout {read_timeout}s;
        proxy_send_timeout {read_timeout}s;
    }}
"""

REDIRECT_LOCATION = """\
    location / {
        return 301 https://$host$request_uri;
    }
"""

TEMPLATE = """\
# mini-railway: host={host} port={port} tls={tls}
# Generated by mini-railway-proxy - do not edit, changes are overwritten.
server {{
    listen 80;
    listen [::]:80;
    server_name {host};

    client_max_body_size {max_body_mb}m;
{gzip}
{acme}
{http_location}
}}
"""

TLS_TEMPLATE = """\
server {{
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {host};

    ssl_certificate {live}/fullchain.pem;
    ssl_certificate_key {live}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:mini_railway_ssl:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    add_header Strict-Transport-Security "max-age=63072000" always;

    client_max_body_size {max_body_mb}m;
{gzip}
{acme}
{proxy_location}
}}
"""

GZIP_BLOCK = """\
    gzip on;
    gzip_proxied any;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;
"""


def fail(code, message):
    print(f"mini-railway-proxy: {message}", file=sys.stderr)
    sys.exit(code)


def system_root():
    """Real root, or a sandbox directory when a non-root user runs the tests.

    The override is ignored for uid 0, so it cannot be abused through sudo.
    """
    override = os.environ.get("MINI_RAILWAY_TEST_ROOT")
    if override and os.geteuid() != 0:
        return override, True
    if os.geteuid() != 0:
        fail(2, "must be run as root (through sudo)")
    return "/", False


def validate_hostname(raw):
    hostname = raw.strip().lower()
    if len(hostname) > MAX_HOSTNAME_LENGTH or not HOSTNAME_RE.fullmatch(hostname):
        fail(2, f"refused hostname {raw!r}: expected a fully-qualified domain name (240 characters at most)")
    return hostname


def ascii_int(name):
    def parse(raw):
        # [0-9] and not \d: \d also matches non-ASCII digits.
        if not re.fullmatch(r"[0-9]{1,5}", raw):
            raise argparse.ArgumentTypeError(f"{name} must be an integer")
        return int(raw)

    return parse


def check_range(name, value, bounds):
    low, high = bounds
    if not low <= value <= high:
        fail(2, f"{name} must be between {low} and {high}")


def reserved_hosts(root):
    try:
        with open(os.path.join(root, "etc/mini-railway/reserved-hosts"), encoding="utf-8") as handle:
            return {line.strip().lower() for line in handle if line.strip() and not line.startswith("#")}
    except FileNotFoundError:
        return set()


def open_lock(root):
    """Lock file in a root-only directory.

    /run/lock is world-writable: another account could pre-create, hold or
    symlink a lock placed there. /run/mini-railway is created 0700 by root.
    """
    lock_dir = os.path.join(root, "run/mini-railway")
    os.makedirs(lock_dir, mode=0o700, exist_ok=True)
    if os.path.islink(lock_dir):
        fail(3, f"{lock_dir} is a symbolic link")
    flags = os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC
    return os.fdopen(os.open(os.path.join(lock_dir, "proxy.lock"), flags, 0o600), "r+")


def read_file(path):
    try:
        with open(path, encoding="utf-8") as handle:
            return handle.read()
    except FileNotFoundError:
        return None


def atomic_write(path, content):
    directory = os.path.dirname(path)
    # The temporary name must not end in ".conf": NGINX includes *.conf.
    fd, tmp_path = tempfile.mkstemp(prefix=".tmp.", suffix=".part", dir=directory)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(tmp_path, 0o644)
        os.replace(tmp_path, path)
    except BaseException:
        if os.path.exists(tmp_path):
            os.unlink(tmp_path)
        raise


def restore(path, previous):
    if previous is None:
        if os.path.exists(path):
            os.unlink(path)
    else:
        atomic_write(path, previous)


def nginx_test():
    result = subprocess.run([NGINX, "-t"], env=SAFE_ENV, capture_output=True, text=True)
    return result.returncode == 0, (result.stderr or result.stdout).strip()


def nginx_reload():
    result = subprocess.run([SYSTEMCTL, "reload", "nginx"], env=SAFE_ENV, capture_output=True, text=True)
    if result.returncode != 0:
        # NGINX may simply be stopped: starting it loads the new configuration.
        result = subprocess.run([SYSTEMCTL, "start", "nginx"], env=SAFE_ENV, capture_output=True, text=True)
    return result.returncode == 0, (result.stderr or result.stdout).strip()


def change(path, previous, new_content, sandbox):
    """Install the new state, validate it with nginx, roll back on any failure.

    The file is live in the include directory before `nginx -t` runs, so the
    section must not be interruptible: an unvalidated file left behind would
    break every later reload.
    """
    for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP, signal.SIGQUIT):
        signal.signal(signum, signal.SIG_IGN)

    if new_content is None:
        os.unlink(path)
    else:
        atomic_write(path, new_content)
    if sandbox:
        return

    try:
        ok, output = nginx_test()
    except BaseException:
        restore(path, previous)
        raise
    if not ok:
        restore(path, previous)
        fail(3, f"nginx rejected the configuration, nothing was changed:\n{output}")

    ok, output = nginx_reload()
    if not ok:
        fail(4, f"configuration written but nginx could not be reloaded:\n{output}")


def list_entries(conf_dir):
    entries = []
    for name in sorted(os.listdir(conf_dir)):
        if not name.endswith(".conf"):
            continue
        content = read_file(os.path.join(conf_dir, name)) or ""
        match = HEADER_RE.match(content.split("\n", 1)[0])
        if match:
            entries.append({"host": match.group(1), "port": int(match.group(2)), "tls": match.group(3) == "1"})
    return entries


def main():
    parser = argparse.ArgumentParser(
        prog="mini-railway-proxy", description=__doc__.split("\n\n")[0], allow_abbrev=False
    )
    commands = parser.add_subparsers(dest="command", required=True)

    apply_cmd = commands.add_parser("apply", allow_abbrev=False)
    apply_cmd.add_argument("--host", required=True)
    apply_cmd.add_argument("--port", required=True, type=ascii_int("--port"))
    apply_cmd.add_argument("--max-body-mb", default=50, type=ascii_int("--max-body-mb"))
    apply_cmd.add_argument("--read-timeout", default=60, type=ascii_int("--read-timeout"))
    apply_cmd.add_argument("--gzip", action="store_true")
    apply_cmd.add_argument("--platform", action="store_true")
    apply_cmd.add_argument("--tls", action="store_true", help="serve HTTPS with the Let's Encrypt certificate of the host")
    apply_cmd.add_argument("--force-https", action="store_true", help="with --tls: redirect HTTP to HTTPS")

    remove_cmd = commands.add_parser("remove", allow_abbrev=False)
    remove_cmd.add_argument("--host", required=True)
    remove_cmd.add_argument("--platform", action="store_true")

    commands.add_parser("list", allow_abbrev=False)
    args = parser.parse_args()

    root, sandbox = system_root()
    conf_dir = os.path.join(root, "etc/nginx/mini-railway.d")
    if not os.path.isdir(conf_dir) or os.path.islink(conf_dir):
        fail(2, f"{conf_dir} does not exist: run scripts/server/setup.sh first")

    with open_lock(root) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)

        if args.command == "list":
            print(json.dumps({"ok": True, "entries": list_entries(conf_dir)}))
            return

        host = validate_hostname(args.host)
        if host in reserved_hosts(root) and not args.platform:
            fail(2, f"{host} is reserved for the platform")

        path = os.path.join(conf_dir, f"{host}.conf")
        if os.path.islink(path):
            fail(2, f"{path} is a symbolic link, refusing to touch it")
        previous = read_file(path)

        if args.command == "apply":
            check_range("--port", args.port, PLATFORM_PORTS if args.platform else APP_PORTS)
            check_range("--max-body-mb", args.max_body_mb, (1, 10240))
            check_range("--read-timeout", args.read_timeout, (1, 3600))
            if previous is None and len(list_entries(conf_dir)) >= MAX_ENTRIES:
                fail(2, f"too many proxy entries (limit {MAX_ENTRIES})")
            live = None
            if args.tls:
                live = os.path.join(root, "etc/letsencrypt/live", host)
                for name in ("fullchain.pem", "privkey.pem"):
                    if not os.path.isfile(os.path.join(live, name)):
                        fail(2, f"no certificate for {host}: issue it first (mini-railway-cert issue --host {host})")
            if args.force_https and not args.tls:
                fail(2, "--force-https needs --tls")
            acme = ACME_LOCATION.format(webroot=os.path.join(root, ACME_WEBROOT))
            gzip = GZIP_BLOCK if args.gzip else ""
            proxy_location = PROXY_LOCATION.format(port=args.port, read_timeout=args.read_timeout)
            content = TEMPLATE.format(
                host=host,
                port=args.port,
                tls=1 if args.tls else 0,
                max_body_mb=args.max_body_mb,
                gzip=gzip,
                acme=acme,
                http_location=REDIRECT_LOCATION if args.force_https else proxy_location,
            )
            if args.tls:
                content += TLS_TEMPLATE.format(
                    host=host,
                    live=live,
                    max_body_mb=args.max_body_mb,
                    gzip=gzip,
                    acme=acme,
                    proxy_location=proxy_location,
                )
            changed = content != previous
            if changed:
                change(path, previous, content, sandbox)
            print(json.dumps({"ok": True, "host": host, "port": args.port, "changed": changed}))
            return

        changed = previous is not None
        if changed:
            change(path, previous, None, sandbox)
        print(json.dumps({"ok": True, "host": host, "changed": changed}))


if __name__ == "__main__":
    main()
